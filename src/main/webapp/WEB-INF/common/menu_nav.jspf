<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
    
<!-- 상단 네비게이션 -->
<nav class="navbar navbar-dark bg-dark px-3">
  <button class="btn btn-outline-light d-md-none me-2" type="button"
          data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
    <span class="navbar-toggler-icon"></span>
  </button>
<a class="navbar-brand mb-0" href="s_dashboard.do" style="text-decoration: none;">SENS</a>
  <div class="ms-auto d-flex align-items-center">
    <span class="text-light small me-3" id="userLabel"></span>
    <button class="btn btn-sm btn-outline-light" onclick="handleLogout()">로그아웃</button>
  </div>
</nav>

<div class="d-flex">

  <!-- 데스크탑 사이드바 (메뉴는 JS에서 동적으로 렌더링) -->
  <div class="sidebar d-none d-md-block p-3">
    <div id="sidebarMenu"></div>
  </div>

  <!-- 모바일 오프캔버스 사이드바 (메뉴는 JS에서 동적으로 렌더링) -->
  <div class="offcanvas offcanvas-start bg-dark" tabindex="-1" id="sidebarOffcanvas">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title text-light">메뉴</h5>
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3">
      <div id="sidebarMenuMobile"></div>
    </div>
  </div>

  <!-- [주의] 위 <div class="d-flex">는 여기서 닫지 않았습니다.
       이 파일을 include하는 페이지가 자신의 콘텐츠(<div class="flex-grow-1 p-4">...)를
       쓴 다음 반드시 </div> 로 닫아줘야 합니다. -->