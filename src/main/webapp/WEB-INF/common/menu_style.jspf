<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
    
body { background: #f8f9fa; }

.sidebar {
  width: 220px;
  min-height: calc(100vh - 56px);
  background: #212529;
}

.sidebar .nav-link,
.offcanvas-body .nav-link {
  color: #adb5bd;
  padding: 8px 12px;
}
.sidebar .nav-link:hover,
.sidebar .nav-link.active,
.offcanvas-body .nav-link:hover,
.offcanvas-body .nav-link.active {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 6px;
}

@media (max-width: 767.98px) {
  .sidebar { display: none; }
}

.sidebar-heading {
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  color: #adb5bd;
  display: block;
}

  .tabulator-row.tabulator-selected {
    background-color: #cfe2ff !important;
  }
  
  /* 타이틀고정 */
    .sticky-toolbar {
    position: sticky;
    top: 0;
    z-index: 1020;
    background-color: #fff;
    padding-top: 1rem;
    margin: -1rem -1rem 0 -1rem;
  }
  
/* 메뉴 컬러 구분: 그룹(폴더) vs 프로그램(실제 이동 링크) */
.sidebar .nav-link.menu-group-link,
.offcanvas-body .nav-link.menu-group-link {
  color: #e9ecef;
}
.sidebar .nav-link.menu-group-link:hover,
.offcanvas-body .nav-link.menu-group-link:hover {
  color: #fff;
}

.sidebar .nav-link.menu-program-link,
.offcanvas-body .nav-link.menu-program-link {
  color: #ffc107;
}
.sidebar .nav-link.menu-program-link:hover,
.sidebar .nav-link.menu-program-link.active,
.offcanvas-body .nav-link.menu-program-link:hover,
.offcanvas-body .nav-link.menu-program-link.active {
  color: #fff;
}

.chevron {
  font-size: 0.7rem;
  transition: transform 0.2s ease;
}
[aria-expanded="true"] .chevron {
  transform: rotate(180deg);
}

#sidebarOffcanvas {
  --bs-offcanvas-width: 240px;
}